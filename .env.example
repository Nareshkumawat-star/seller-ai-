# ---------------------------------------------------------------------------
# Seller AI — server-side configuration
# Copy to .env.local for development. Never commit real credentials.
# These values are read by the Next.js server only and are never sent to the
# browser (the client sees capability booleans, not URLs or keys).
# ---------------------------------------------------------------------------

# Ollama HTTP endpoint reachable FROM THE SERVER PROCESS.
# Local development: keep Ollama bound to loopback.
OLLAMA_BASE_URL=http://localhost:11434

# Text model used for listing generation. Must be an installed tag.
# Verify with `ollama list` and pull with `ollama pull <tag>`.
# Any Qwen-family instruction model works; smaller tags are faster on CPU.
OLLAMA_MODEL=qwen3:4b

# Optional: vision-capable model for the /api/analyze-image endpoint.
# Leave empty to disable image analysis entirely (text generation is unaffected).
# Example installed tags: qwen2.5vl:3b, llava:7b, gemma3:4b
OLLAMA_VISION_MODEL=

# Per-request inference timeout in milliseconds (5000–600000).
# Local CPU inference on a 3–8B model commonly takes 20–120 seconds.
OLLAMA_TIMEOUT_MS=120000

# Maximum product image size for optional analysis, in megabytes (1–20).
MAX_IMAGE_SIZE_MB=5

# Bearer token, only if your inference host requires authentication
# (for example a secured remote Ollama behind a reverse proxy).
OLLAMA_API_KEY=

# Per-IP generation requests per minute on this instance (1–240).
RATE_LIMIT_PER_MINUTE=12
